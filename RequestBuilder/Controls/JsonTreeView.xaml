<UserControl x:Class="RequestBuilder.Controls.JsonTreeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:RequestBuilder.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="600">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Row hit-test wrapper: owns the right-click context menu for a node. Selection/keyboard focus
             now lives on the individual stop editors below, not on this Border. -->
        <Style x:Key="RowHitTestStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="2 1"/>
            <Setter Property="ContextMenu">
                <Setter.Value>
                    <ContextMenu/>
                </Setter.Value>
            </Setter>
            <EventSetter Event="ContextMenuOpening" Handler="Row_ContextMenuOpening"/>
        </Style>

        <!-- Base style for every focusable "stop" TextBox (name, leaf value, braces, null, closing brace).
             Carries the shared focus-tracking/keyboard-shortcut wiring so the DataTemplate below only has
             to set Tag (which stop) and Style (which look) per element. -->
        <Style x:Key="InlineEditorStyle" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinWidth" Value="16"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <EventSetter Event="Loaded" Handler="Stop_Loaded"/>
            <EventSetter Event="Unloaded" Handler="Stop_Unloaded"/>
            <EventSetter Event="PreviewKeyDown" Handler="Stop_PreviewKeyDown"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="Background" Value="#332B88D8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PropertyNameEditorStyle" TargetType="TextBox" BasedOn="{StaticResource InlineEditorStyle}">
            <Setter Property="Foreground" Value="#4775BE"/>
        </Style>

        <Style x:Key="StringValueEditorStyle" TargetType="TextBox" BasedOn="{StaticResource InlineEditorStyle}">
            <Setter Property="Foreground" Value="#A4152A"/>
        </Style>

        <!-- Braces/brackets/null: not user-editable text, but still a real focusable stop (keyboard nav,
             Enter/Shift+Enter shortcuts, context menu target), so it's a read-only TextBox rather than a
             plain TextBlock. -->
        <Style x:Key="ReadOnlyStopStyle" TargetType="TextBox" BasedOn="{StaticResource InlineEditorStyle}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="IsReadOnlyCaretVisible" Value="False"/>
            <Setter Property="Cursor" Value="Arrow"/>
        </Style>

        <Style x:Key="BoolValueStyle" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Foreground" Value="#0A00FE"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <EventSetter Event="Loaded" Handler="Stop_Loaded"/>
            <EventSetter Event="Unloaded" Handler="Stop_Unloaded"/>
            <EventSetter Event="PreviewKeyDown" Handler="Stop_PreviewKeyDown"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="Background" Value="#332B88D8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Implicit (keyless) template: matched automatically by DataType wherever a JsonNodeViewModel
             needs rendering, including recursively from the ItemsControl below. A keyed template with a
             StaticResource self-reference does NOT reliably resolve here (deferred-content load ordering),
             so this must stay keyless. -->
        <DataTemplate DataType="{x:Type vm:JsonNodeViewModel}">
            <StackPanel>
                <Border Style="{StaticResource RowHitTestStyle}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&quot;" Visibility="{Binding HasName, Converter={StaticResource BoolToVis}}"/>
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="{x:Static vm:JsonStopKind.Name}"
                                 Style="{StaticResource PropertyNameEditorStyle}"
                                 Visibility="{Binding HasName, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="&quot;: " Visibility="{Binding HasName, Converter={StaticResource BoolToVis}}"/>

                        <TextBox Text="{}{" Tag="{x:Static vm:JsonStopKind.Value}"
                                 Style="{StaticResource ReadOnlyStopStyle}" FontWeight="Bold"
                                 Visibility="{Binding IsObject, Converter={StaticResource BoolToVis}}"/>
                        <TextBox Text="[" Tag="{x:Static vm:JsonStopKind.Value}"
                                 Style="{StaticResource ReadOnlyStopStyle}" FontWeight="Bold"
                                 Visibility="{Binding IsArray, Converter={StaticResource BoolToVis}}"/>

                        <TextBox Text="{Binding StringValue, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="{x:Static vm:JsonStopKind.Value}"
                                 Style="{StaticResource StringValueEditorStyle}"
                                 Visibility="{Binding IsString, Converter={StaticResource BoolToVis}}"/>
                        <TextBox Text="{Binding StringValue, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="{x:Static vm:JsonStopKind.Value}"
                                 Style="{StaticResource InlineEditorStyle}"
                                 Visibility="{Binding IsNumber, Converter={StaticResource BoolToVis}}"/>
                        <CheckBox IsChecked="{Binding BoolValue}"
                                  Tag="{x:Static vm:JsonStopKind.Value}"
                                  Style="{StaticResource BoolValueStyle}"
                                  Visibility="{Binding IsBoolean, Converter={StaticResource BoolToVis}}"/>
                        <TextBox Text="null" Tag="{x:Static vm:JsonStopKind.Value}"
                                 Style="{StaticResource ReadOnlyStopStyle}"
                                 FontStyle="Italic" Foreground="#0A00FE"
                                 Visibility="{Binding IsNull, Converter={StaticResource BoolToVis}}"/>

                        <TextBlock Text="," Visibility="{Binding ShowLeafComma, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Children}"
                              Margin="20 0 0 0"
                              Visibility="{Binding IsContainer, Converter={StaticResource BoolToVis}}"/>

                <Border Style="{StaticResource RowHitTestStyle}" Visibility="{Binding IsContainer, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBox Text="}" Tag="{x:Static vm:JsonStopKind.Close}"
                                 Style="{StaticResource ReadOnlyStopStyle}" FontWeight="Bold"
                                 Visibility="{Binding IsObject, Converter={StaticResource BoolToVis}}"/>
                        <TextBox Text="]" Tag="{x:Static vm:JsonStopKind.Close}"
                                 Style="{StaticResource ReadOnlyStopStyle}" FontWeight="Bold"
                                 Visibility="{Binding IsArray, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="," Visibility="{Binding ShowClosingComma, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <ContentPresenter x:Name="RootPresenter"
                           TextElement.FontFamily="Consolas"
                           TextElement.FontSize="14"/>
    </Grid>
</UserControl>
